{
  "installCommand": "npm install",
  "buildCommand": "npm run build -w client && cp -r client/dist dist",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://wastely-api.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
